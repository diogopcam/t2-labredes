{
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex-mactex",
      "command": "/Library/TeX/texbin/pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex-mactex",
      "tools": [
        "pdflatex-mactex",
        "pdflatex-mactex"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "pdflatex-mactex"
}
